# Generates the table of symbols that the engine looks up by name at runtime
# (entity classes from *.ecl files and SKA shaders). Used by the static
# CDynamicLoader in builds where everything is linked into one binary (web).
#
# Run in script mode:
#   cmake -DOUT=<file.cpp> -DTABLES=<list of *_tables.h> -DSHADERS=<list of shader .cpp> -P gen_static_symbols.cmake

set(entity_classes "")
foreach(f ${TABLES})
  file(READ "${f}" content)
  string(REGEX MATCHALL "ENTITY_CLASSDEFINITION\\([A-Za-z0-9_]+" defs "${content}")
  foreach(d ${defs})
    string(REPLACE "ENTITY_CLASSDEFINITION(" "" cls "${d}")
    list(APPEND entity_classes ${cls})
  endforeach()
endforeach()

set(shaders "")
foreach(f ${SHADERS})
  file(READ "${f}" content)
  string(REGEX MATCHALL "SHADER_MAIN\\([A-Za-z0-9_]+" defs "${content}")
  foreach(d ${defs})
    string(REPLACE "SHADER_MAIN(" "" name "${d}")
    list(APPEND shaders ${name})
  endforeach()
endforeach()

list(REMOVE_DUPLICATES entity_classes)
list(SORT entity_classes)
if(shaders)
  list(REMOVE_DUPLICATES shaders)
  list(SORT shaders)
endif()

set(decls "")
set(entries "")
foreach(cls ${entity_classes})
  string(APPEND decls "extern \"C\" CDLLEntityClass ${cls}_DLLClass;\n")
  string(APPEND entries "  { \"${cls}_DLLClass\", (void *)&${cls}_DLLClass },\n")
endforeach()
foreach(name ${shaders})
  string(APPEND decls "extern \"C\" void Shader_${name}(void);\n")
  string(APPEND decls "extern \"C\" void Shader_Desc_${name}(ShaderDesc &shDesc);\n")
  string(APPEND entries "  { \"Shader_${name}\", (void *)&Shader_${name} },\n")
  string(APPEND entries "  { \"Shader_Desc_${name}\", (void *)&Shader_Desc_${name} },\n")
endforeach()

set(text "// Generated by cmake/gen_static_symbols.cmake -- do not edit.\n\n")
string(APPEND text "#include \"Engine/StdH.h\"\n")
string(APPEND text "#include <Engine/Entities/EntityProperties.h>\n")
string(APPEND text "#include <Engine/Graphics/Shader.h>\n")
string(APPEND text "#include <Engine/Base/Emscripten/StaticSymbols.h>\n\n")
string(APPEND text "${decls}\n")
string(APPEND text "const SStaticSymbol _assGeneratedSymbols[] = {\n${entries}  { NULL, NULL }\n};\n")

# only touch the output when it changes, to avoid needless rebuilds
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL text)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${text}")
